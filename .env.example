# ============================================================
# Virtus City — Variables de entorno
# Copiá este archivo como ".env" y completá los valores.
# NUNCA subas ".env" al repositorio.
# ============================================================

# --- Modo de la aplicación -----------------------------------
# "local"  => demostración con persistencia en el navegador (localStorage).
# "remote" => usa un backend real (por ejemplo Supabase).
VITE_DATA_MODE=local

# --- Backend remoto (solo si VITE_DATA_MODE=remote) ----------
# Estas claves son PÚBLICAS (anon) por diseño si usás Supabase con RLS.
# NUNCA pongas aquí la "service_role" ni ninguna clave privada.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Límites de la aplicación --------------------------------
VITE_MAX_IMAGE_DIMENSION=1024
VITE_MAX_UPLOAD_BYTES=2097152
VITE_PUBLISH_COOLDOWN_SECONDS=30
